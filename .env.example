# Copy to .env and fill values
OPENAI_API_KEY=

# Model names (see OpenAI models docs)
OPENAI_MODEL_REASONING=gpt-5.4-2026-03-05
OPENAI_MODEL_FAST=gpt-5.4-mini-2026-03-17
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_S=240
OPENAI_IMAGE_RETRY_ATTEMPTS=3

# Embeddings model
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# OpenAI transient error retry controls
OPENAI_RETRY_ATTEMPTS=3
OPENAI_RETRY_BASE_WAIT_S=5
OPENAI_RETRY_MAX_WAIT_S=90
OPENAI_RETRY_JITTER_RATIO=0.20
OPENAI_STRUCTURED_STREAMING=false
# Structured reasoning calls use background create + short polling to avoid
# corporate-proxy connection-duration/idle limits. Set ENABLED=false to disable
# background mode globally. Set ALL=false to use the prompt-size threshold only.
OPENAI_STRUCTURED_BACKGROUND_ENABLED=true
OPENAI_STRUCTURED_BACKGROUND_ALL=false
OPENAI_STRUCTURED_BACKGROUND_MIN_CHARS=30000
OPENAI_STRUCTURED_BACKGROUND_POLL_S=2
OPENAI_STRUCTURED_BACKGROUND_GRACE_S=300
OPENAI_REASONING_EFFORT_HIGH=high
OPENAI_REASONING_EFFORT_MEDIUM=medium
OPENAI_REASONING_EFFORT_LOW=low

# DeckPlan is a large structured-output request. Keep it bounded and use medium
# reasoning by default; understanding and narrative can remain high effort.
OPENAI_REASONING_EFFORT_DECK_PLAN=medium
OPENAI_DECK_PLAN_TIMEOUT_S=420
OPENAI_DECK_PLAN_RAG_MAX_CHARS=18000
OPENAI_DECK_PLAN_LAYOUT_LIMIT=64
OPENAI_DECK_PLAN_PROMPT_MAX_CHARS=30000
OPENAI_DECK_PLAN_CHUNKED=true
OPENAI_DECK_PLAN_BATCH_SIZE=4
# Phase 1: expand sections via parallel specialist architects (Application,
# Integration, Data) each consuming the Solution Brief, instead of one
# generalist. Off by default so it can be A/B'd against the chunked path.
# This only seeds the default state of the "Specialist-architect planning"
# toggle in the UI sidebar; the toggle overrides it per run, so behavior can
# be switched without changing this value or redeploying.
OPENAI_DECK_PLAN_SPECIALISTS=false

# Large RFP packages are extracted in bounded fast-model calls before the final
# reasoning-model understanding call. This avoids oversized 500k+ character prompts.
OPENAI_UNDERSTANDING_DIRECT_MAX_CHARS=180000
OPENAI_UNDERSTANDING_EVIDENCE_CHUNK_CHARS=55000
OPENAI_UNDERSTANDING_EVIDENCE_MAX_CHARS=180000
OPENAI_UNDERSTANDING_EVIDENCE_WORKERS=2
OPENAI_UNDERSTANDING_EVIDENCE_TIMEOUT_S=300
OPENAI_CONTEXTUAL_EVIDENCE_LLM_ENABLED=false
OPENAI_CONTEXTUAL_EVIDENCE_TIMEOUT_S=60
OPENAI_CONTEXTUAL_EVIDENCE_GRACE_S=30
OPENAI_CONTEXTUAL_REFERENCE_MAX_CHARS=18000
OPENAI_UNDERSTANDING_EVIDENCE_GRACE_S=60
OPENAI_UNDERSTANDING_EVIDENCE_CACHE=true
OPENAI_NOTES_BATCH_SIZE=6
OPENAI_NOTES_WORKERS=3

# Reuse plan and diagram outputs for the same inputs/settings/prompt logic.
RFP2DECK_PIPELINE_CACHE=true
RFP2DECK_PIPELINE_CACHE_VERSION=v3-proposal-derived-architecture

# App
APP_DATA_DIR=.data
# Corporate template. Defaults to the bundled, repo-relative template below, which
# is resolved against the project root and works unchanged on any host (local, WSL,
# Streamlit Cloud, containers). Leave it as-is unless you want to override.
HCLTECH_TEMPLATE_PATH=templates/hcltech_expanded_v5.potx
# To point at a template outside the repo, use an absolute path instead. Windows
# drive-letter paths are auto-mapped to /mnt/<drive>/... when running in WSL:
# HCLTECH_TEMPLATE_PATH='C:\path\to\Expanded Version 5.0.potx'
# HCLTECH_TEMPLATE_PATH='/mnt/c/path/to/Expanded Version 5.0.potx'
TEMPLATE_CACHE_DIR=.data/templates

# SharePoint (device-code auth)
SP_TENANT_ID=
SP_CLIENT_ID=
SP_SCOPES=Files.Read.All,Sites.Read.All

# Password to avoid access to the site by public when deployed on Public domain
APP_PASSWORD=

# Logging
LOG_LEVEL=DEBUG
